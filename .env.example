# Copien este archivo a ".env" en su propia máquina (nunca suban el ".env" real)
# y rellenen los valores ahí. Aquí solo van los NOMBRES de las variables,
# nunca las claves reales (Instrucción #5 del cuestionario).
#
# Para correr los scripts localmente, en Anaconda Prompt:
#   setx ALPHA_VANTAGE_API_KEY "su_clave_real_aqui"
#   setx GEMINI_API_KEY "su_clave_real_aqui"
# (cierren y vuelvan a abrir la terminal para que el cambio aplique)
#
# Para GitHub Actions (actualización automática), estas mismas variables se
# configuran como "Secrets" en GitHub: Settings -> Secrets and variables ->
# Actions -> New repository secret. Nunca se escriben en ningún archivo del repo.

ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=
